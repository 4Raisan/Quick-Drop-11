# Local development defaults to isolated .data files; no credentials needed.
# Set these on Vercel, never in public browser assets:
BLOB_READ_WRITE_TOKEN=
CRON_SECRET=
# Explicit opt-in only if development should use remote storage:
# QUICK_DROP_STORAGE=blob

# Public aggregate allowance only; no credentials or account identifiers:
# QUICK_DROP_STORAGE_ALLOWANCE_BYTES=1000000000

# Supabase production backend (all secrets stay server-side):
# QUICK_DROP_STORAGE_PROVIDER=supabase
QUICK_DROP_SUPABASE_URL=
QUICK_DROP_SUPABASE_SERVICE_KEY=
# Explicit opt-in for remote local testing only:
# QUICK_DROP_REMOTE_LOCAL=1
