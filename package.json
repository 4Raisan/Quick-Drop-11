{
  "name": "temptransfer",
  "version": "1.1.0",
  "description": "Community temporary text transfer web app with 24-hour auto-clear and direct copy buttons",
  "main": "server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "build": "esbuild frontend/uploads.js --bundle --platform=browser --minify --outfile=public/uploads.bundle.js"
  },
  "keywords": [
    "temp-transfer",
    "text-transfer",
    "clipboard",
    "temporary-notes",
    "auto-expire",
    "community"
  ],
  "author": "4Raisan",
  "license": "MIT",
  "dependencies": {
    "@vercel/blob": "^2.8.0"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
